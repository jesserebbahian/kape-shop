    {
      "name": "5 \u00b7 Manual Maya sandbox",
      "item": [
        {
          "name": "Start Maya sandbox checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/checkout",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingName\": \"Kape Demo\",\n  \"shippingPhone\": \"09171234567\",\n  \"shippingAddress\": \"12 Rizal Street, Iligan City\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const result = pm.response.json();",
                  "pm.test('API envelope', () => pm.expect(result.success).to.eql(true));",
                  "if (result.success) pm.collectionVariables.set('orderId', result.data.id);",
                  "if (result.success) pm.collectionVariables.set('checkoutUrl', result.data.checkoutUrl);",
                  "pm.test('Hosted checkout link', () => pm.expect(result.data.checkoutUrl).to.match(/^https:/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Repeat the same checkout key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/checkout",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shippingName\": \"Kape Demo\",\n  \"shippingPhone\": \"09171234567\",\n  \"shippingAddress\": \"12 Rizal Street, Iligan City\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const result = pm.response.json();",
                  "pm.test('API envelope', () => pm.expect(result.success).to.eql(true));",
                  "pm.test('Same order', () => pm.expect(String(result.data.id)).to.eql(String(pm.collectionVariables.get('orderId'))));"
                ]
              }
            }
          ]
        },
