{
  "info": {
    "name": "Kape Shop API",
    "description": "Run folders 1\u20134 against an isolated seeded demo database. Folder 5 opens a real sandbox session and is manual. Open the captured checkoutUrl for sandbox payment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 \u00b7 Authentication",
      "item": [
        {
          "name": "Customer login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test('API envelope', () => pm.expect(result.success).to.eql(true));",
                  "if (result.success) pm.collectionVariables.set('customerToken', result.data.token);"
                ]
              }
            }
